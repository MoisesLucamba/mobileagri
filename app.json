{
  "expo": {
    "name": "Agrilink",
    "slug": "agrilink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Agrilink_AppIcon.png",
    "scheme": "agrilink",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/Agrilink_AppIcon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Agrilink_AppIcon.png",
        "monochromeImage": "./assets/images/Agrilink_SDL.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lucamba.agrilink"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que a AgriLink use a sua localização para mostrar a sua posição no mapa e encontrar entregas próximas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/Agrilink_AppIcon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad37c185-fdfc-408b-a38a-2b09384b4eed"
      }
    }
  }
}
